{% assign talks_sorted = site.data.talks | sort: 'date' | reverse %}
{% assign talks_by_year = talks_sorted | group_by_exp: 'talk', "talk.date | date: '%Y'" %}
{% for year_group in talks_by_year %}
  <div class="talks-year-section">
    <h2 class="talks-year">{{ year_group.name }}</h2>
    <ul class="talks-list">
      {% for talk in year_group.items %}
        {% capture talk_date %}
          {%- if talk.date_display -%}
            {{- talk.date_display -}}
          {%- else -%}
            {{- talk.date | date: "%m/%d" -}}
          {%- endif -%}
        {% endcapture %}
        <li class="talks-entry">
          <span class="talks-date">{{ talk_date | strip }}</span> -
          {% if talk.type == 'poster' %}Poster:{% endif %}
          {% if talk.link %}
            {% if talk.link contains '://' %}
              <a href="{{ talk.link }}"
                ><b>{{ talk.title }}</b></a
              >
            {% else %}
              <a href="{{ talk.link | prepend: '/talks/' | relative_url }}"
                ><b>{{ talk.title }}</b></a
              >
            {% endif %}
          {% else %}
            <b>{{ talk.title }}</b>
          {% endif %}
          {% if talk.proceedings %}
            + <a href="{{ talk.proceedings }}">Proceedings</a>
          {% endif %}
          at <em>{{ talk.venue }}</em>
          {%- if talk.location %}, {{ talk.location }}{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endfor %}
